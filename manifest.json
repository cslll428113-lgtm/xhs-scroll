{
  "manifest_version": 3,
  "name": "小红薯顺滑刷 · 鼠落",
  "version": "0.4.4",
  "description": "完整收集当前页面视频，一键刷新独立页换一批；不再主动滚动加载，不刷新原首页。",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "diagnostics.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "policy.js",
        "queue.js",
        "live-queue.js",
        "card-target.js",
        "card-click.js",
        "navigation.js",
        "floating.js",
        "close-control.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
